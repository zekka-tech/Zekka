# Legacy convenience template.
# Prefer:
# - .env.example.secure for running the backend directly
# - .env.production.example for docker compose

NODE_ENV=development
PORT=3000

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-64-hex-characters

DATABASE_URL=postgresql://zekka_user:changeme@localhost:5432/zekka
# DATABASE_SSL=true                        # force TLS to PostgreSQL (default: on in production)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # escape hatch for self-signed chains (not recommended)
# DATABASE_SSL_CA=/path/to/ca.pem          # custom CA (inline PEM also accepted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=ollama
MAX_CONCURRENT_AGENTS=10

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DAILY_BUDGET=50
MONTHLY_BUDGET=1000

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Billing is OFF by default; the app runs fine without any Stripe config.
# To enable, set BILLING_ENABLED=true and provide the keys below (from your
# Stripe dashboard — https://dashboard.stripe.com/apikeys / /webhooks).
BILLING_ENABLED=false
# Secret API key (use a sk_test_... key in development):
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /webhooks/stripe (whsec_...). In local dev,
# `stripe listen --forward-to localhost:3000/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=
# Map internal plan keys → Stripe Price IDs (JSON object). Create Products +
# recurring Prices in Stripe, then paste their price_... ids here, e.g.:
#   STRIPE_PRICE_MAP={"pro":"price_123","business":"price_456"}
STRIPE_PRICE_MAP=
# Optional metered (usage-based) Price ID for per-unit billing:
STRIPE_METERED_USAGE_PRICE_ID=
# Public base URL used to build Checkout/Portal return links:
APP_URL=http://localhost:3000
# Optional explicit overrides (default to APP_URL + /settings/billing paths):
# BILLING_PORTAL_RETURN_URL=
# BILLING_CHECKOUT_SUCCESS_URL=
# BILLING_CHECKOUT_CANCEL_URL=
