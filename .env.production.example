# Backend compose environment
# Copy to .env.production before running docker compose.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# App security
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-64-hex-characters
JWT_EXPIRATION=24h

# Database used by the compose stack
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zekka_production
DB_USER=zekka_user
DB_PASSWORD=<generate: openssl rand -hex 32>
DATABASE_URL=postgresql://zekka_user:<DB_PASSWORD>@postgres:5432/zekka_production?sslmode=disable
# TLS to PostgreSQL. Defaults: enabled in production with full certificate
# verification. Set DATABASE_SSL=false only when the database is reached over
# a trusted private network (e.g. the docker-compose internal network).
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # escape hatch for self-signed chains (not recommended)
# DATABASE_SSL_CA=/path/to/ca.pem          # custom CA (inline PEM also accepted)

# Redis used by the compose stack
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<generate: openssl rand -hex 32>

# Monitoring
GRAFANA_ADMIN_PASSWORD=<generate: openssl rand -hex 16>

# Optional external providers
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
DEFAULT_MODEL=ollama
MAX_CONCURRENT_AGENTS=10
DAILY_BUDGET=50
MONTHLY_BUDGET=1000

# Optional Vault wiring
VAULT_ENABLED=false
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Set BILLING_ENABLED=true to turn on the SaaS billing endpoints. When enabled,
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are REQUIRED (the app fails fast
# at boot otherwise). Keep these in a secret manager / Vault, never in git.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=<stripe live/secret key: sk_live_...>
STRIPE_WEBHOOK_SECRET=<stripe webhook signing secret: whsec_...>
# JSON map of plan → Stripe Price ID (price IDs are not secret):
STRIPE_PRICE_MAP={"pro":"price_REPLACE","business":"price_REPLACE"}
STRIPE_METERED_USAGE_PRICE_ID=
# Public HTTPS base URL (used for Checkout/Portal redirects):
APP_URL=https://zekka.yourdomain.com
